[codespell]
builtin = clear,rare,en-GB_to_en-US
skip = *.pdf,*.png,*.jpg,*.jpeg,*.gif,*.csv,*.tsv,*.json,*.geojson,*.graphml,*.ipynb,*.html,*.svg,*.bib,*.bbl,*.lock,*.parquet,*.rda,*.rds,*.RData,*.dta,*.xlsx,*.xml,*.min.js,*.map,*.log,*.aux,./tabs
ignore-words-list = autmobiles,busines,classfied,classifed,classsified,colour,finacial,foriegn,liesure,millenium,natioanl,reviw,stlye,tha
